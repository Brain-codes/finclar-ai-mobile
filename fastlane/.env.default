# Firebase App Distribution config — loaded automatically by fastlane (dotenv).
# App IDs are not secret (they ship inside the app), so they live here in git.
# The service-account JSON IS secret and is gitignored — see fastlane/README section.

FIREBASE_ANDROID_APP_ID=1:1092747272049:android:2a349ae686c328143560d0
FIREBASE_IOS_APP_ID=1:1092747272049:ios:0371b2f3d4ebb2113560d0

# Path (relative to the project root) to the Firebase service-account JSON used to
# authenticate uploads. Download it from Firebase Console -> Project settings ->
# Service accounts -> Generate new private key. Keep it OUT of git.
FIREBASE_SERVICE_ACCOUNT=fastlane/firebase-service-account.json

# Firebase App Distribution tester group aliases (create these in the Firebase
# console → App Distribution → Testers and Groups). Comma-separate for multiple.
# These are the group ALIASES (auto-derived from the name, lowercased/hyphenated),
# not the display name — verify they match exactly. Leave blank to skip grouping.
# Split per platform: iOS is invite-only until the paid Apple account is ready, so
# the Android lane must not notify iPhone-only testers who can't install yet.
FIREBASE_ANDROID_TESTER_GROUPS=android-testers
FIREBASE_IOS_TESTER_GROUPS=ios-testers

# fastlane requires a UTF-8 locale to parse commit messages
LANG=en_US.UTF-8
LC_ALL=en_US.UTF-8
